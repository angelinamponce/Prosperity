# Copy to .env.local and fill in. .env.local is git-ignored.

# --- Browser (baked into the build; never put secrets here) ---
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
# Where the Sprout server lives when it's not on this site's own /api. In CI this comes from the
# REACT_APP_SPROUT_API_URL repository variable (see ../DEPLOY.md). Leave empty locally: npm start proxies /api.
REACT_APP_SPROUT_API_URL=
# Set to 1 to force Sprout's scripted preview replies even when a server is reachable.
REACT_APP_SPROUT_MOCK=

# --- Sprout server only (`npm run server`); never sent to the browser ---
# Which model answers: gemini (default; Google AI free tier) or anthropic.
SPROUT_LLM_PROVIDER=gemini
# Without the chosen provider's key the app falls back to scripted preview replies.
# Gemini key: aistudio.google.com/apikey (free tier). Claude key: platform.claude.com.
GEMINI_API_KEY=
SPROUT_GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
SPROUT_MODEL=claude-sonnet-5-5
# low | medium | high (low suits short chat answers): Claude's effort, or Gemini's thinking level
SPROUT_EFFORT=low
SPROUT_PORT=8787
SPROUT_RATE_PER_MINUTE=8
SPROUT_RATE_PER_DAY=80
# Global caps per UTC day across all visitors; past either, the app falls back to preview replies until midnight UTC.
SPROUT_DAILY_MESSAGE_CAP=300
SPROUT_DAILY_TOKEN_CAP=1500000
# Comma-separated sites allowed to call the server from another domain. Localhost is also allowed unless NODE_ENV=production,
# which also refuses chat requests that send no Origin header.
SPROUT_ALLOWED_ORIGINS=https://angelinamponce.github.io
NODE_ENV=
# Set to 1 behind a proxy/load balancer so rate limits use X-Forwarded-For.
SPROUT_TRUST_PROXY=
