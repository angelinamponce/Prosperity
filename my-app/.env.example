# Copy to .env.local and fill in. .env.local is git-ignored.

# --- Browser (baked into the build; never put secrets here) ---
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
# Where the Sprout server lives when it's not on this site's own /api (e.g. https://sprout.example.com).
REACT_APP_SPROUT_API_URL=
# Set to 1 to force Sprout's scripted preview replies even when a server is reachable.
REACT_APP_SPROUT_MOCK=

# --- Sprout server only (`npm run server`); never sent to the browser ---
# Without a key the app falls back to scripted preview replies.
ANTHROPIC_API_KEY=
SPROUT_MODEL=claude-sonnet-5-5
# low | medium | high (low suits short chat answers)
SPROUT_EFFORT=low
SPROUT_PORT=8787
SPROUT_RATE_PER_MINUTE=8
SPROUT_RATE_PER_DAY=80
# Comma-separated origins allowed to call the server from another domain (e.g. https://angelinamponce.github.io).
SPROUT_ALLOWED_ORIGINS=
# Set to 1 behind a proxy/load balancer so rate limits use X-Forwarded-For.
SPROUT_TRUST_PROXY=
